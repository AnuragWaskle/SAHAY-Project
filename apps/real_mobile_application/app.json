{
  "expo": {
    "name": "Sahay Civic Intelligence",
    "slug": "sahay-real-mobile-application",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anuragwaskle.sahayrealmobileapplication"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.anuragwaskle.sahayrealmobileapplication",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDummyKeyForTestingDoNotUseInProd"
        }
      }
    },
    "extra": {
      "eas": {
        "projectId": "e401c54b-33b0-4076-8126-bb642db7e2d5"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Sahay to use your location to accurately map civic issues."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sahay to access your camera to capture photos of civic issues."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sahay to access your photos to attach existing images to your reports."
        }
      ]
    ],
    "owner": "anuragwaskle"
  }
}
